# Copy to .env.local for local dev, or set these in the Vercel project.
# All are optional locally: without them the app reads the committed data/ snapshot
# and shows the daily close (no live ticking).

# Vercel Blob (auto-added when you create a Blob store in the Vercel dashboard).
# Required in production so the daily cron can publish the dataset.
BLOB_READ_WRITE_TOKEN=
# Optional: the store's public base URL, e.g. https://<id>.public.blob.vercel-storage.com
# Lets reads skip a list() lookup. The seed script prints this.
BLOB_BASE_URL=

# Intraday live quotes (Finnhub free tier, 60 req/min). https://finnhub.io
FINNHUB_API_KEY=

# Daily batch bars for the cron (Twelve Data free tier). https://twelvedata.com
TWELVEDATA_API_KEY=

# Shared secret protecting /api/cron/refresh. Vercel Cron sends it automatically.
CRON_SECRET=
